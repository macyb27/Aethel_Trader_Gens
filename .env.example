# ÆTHER-TRADER Ω v4.1 - Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE (Required)
# ═══════════════════════════════════════════════════════════════════════════
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ═══════════════════════════════════════════════════════════════════════════
# API CONFIGURATION (Optional - for direct API access without Supabase)
# ═══════════════════════════════════════════════════════════════════════════
VITE_API_BASE_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS (Optional)
# ═══════════════════════════════════════════════════════════════════════════
VITE_ENABLE_REAL_TRADING=false
VITE_ENABLE_AI_SENTIMENT=true
VITE_ENABLE_QUANTUM_EDGE=true
VITE_DEBUG_MODE=false

# ═══════════════════════════════════════════════════════════════════════════
# EXCHANGE API KEYS (Store securely in Supabase, not here!)
# These are only for local development/testing
# ═══════════════════════════════════════════════════════════════════════════
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ═══════════════════════════════════════════════════════════════════════════
# DATA & AI PROVIDERS (Store securely in Supabase, not here!)
# ═══════════════════════════════════════════════════════════════════════════
