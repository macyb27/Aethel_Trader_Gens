# =============================================================================
# Aether Trader – Monorepo Environment (Beispiel)
# Kopieren nach .env und Werte setzen. Niemals Secrets committen.
# =============================================================================

# --- Allgemein ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Web (Solid + Vite) – Supabase ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Mobile (Expo) – siehe apps/mobile/server/_core/env.ts ---
DATABASE_URL=postgresql://user:pass@localhost:5432/aether_trader
SESSION_SECRET=change-me-min-32-chars-random
JWT_SECRET=change-me-min-32-chars-random
OPENAI_API_KEY=
MANUS_API_KEY=

# =============================================================================
# Exchanges (REST / WebSocket) – bevorzugt Testnet / Paper
# =============================================================================

# Alpaca (Paper: https://paper-api.alpaca.markets)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Generisch (falls ein Connector ENV-Prefix nutzt)
EXCHANGE_DEFAULT=alpaca

# =============================================================================
# Marktdaten & News
# =============================================================================
FINNHUB_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=

# =============================================================================
# LLM / Reasoning (Orchestrierung, Sentiment, keine Roh-Orders)
# =============================================================================
LLM_PROVIDER=openai
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000

# =============================================================================
# Vector-Datenbank & Embeddings (Strategy Memory, Retrieval)
# =============================================================================
VECTOR_DB_PROVIDER=pgvector
# Option A: Supabase / Postgres mit pgvector (gleiche DB wie DATABASE_URL möglich)
PGVECTOR_CONNECTION_STRING=
# Option B: dediziert
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# =============================================================================
# Safety / Oracle Shield (Schwellen – Beispielwerte anpassen)
# =============================================================================
SAFETY_MAX_DAILY_DRAWDOWN_PCT=5
SAFETY_MAX_POSITION_NOTIONAL_USD=10000
SAFETY_ORACLE_SHIELD_ENABLED=true
SAFETY_KILL_SWITCH=false

# =============================================================================
# Paper Trading
# =============================================================================
PAPER_TRADING_ENABLED=true
PAPER_INITIAL_BALANCE_USD=100000
PAPER_SLIPPAGE_BPS=5

# =============================================================================
# Redis / Queue (optional, Backend-Jobs)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Cloudflare (optional, Web-Deploy)
# =============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
