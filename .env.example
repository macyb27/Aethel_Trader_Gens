# ═══════════════════════════════════════════════════════════════════════════
# ÆTHER-TRADER Ω v4.0 - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# ALPACA API (Paper Trading & Live Trading)
# Get your API keys at: https://alpaca.markets/
# ─────────────────────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
# For paper trading (recommended for testing):
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# For live trading (use with caution):
# ALPACA_BASE_URL=https://api.alpaca.markets

# ─────────────────────────────────────────────────────────────────────────────
# FINNHUB API (Market Data & News)
# Get your API key at: https://finnhub.io/
# ─────────────────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# COINBASE ADVANCED TRADE API (Cryptocurrency Trading)
# Get your API keys at: https://www.coinbase.com/settings/api
# ─────────────────────────────────────────────────────────────────────────────
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# KRAKEN API (Cryptocurrency Trading)
# Get your API keys at: https://www.kraken.com/u/security/api
# ─────────────────────────────────────────────────────────────────────────────
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# BYBIT API (Cryptocurrency Derivatives)
# Get your API keys at: https://www.bybit.com/app/user/api-management
# ─────────────────────────────────────────────────────────────────────────────
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (Database & Authentication)
# Get your credentials at: https://supabase.com/dashboard
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────────────────────────────────────
# MOBILE APP CONFIGURATION (React Native/Expo)
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://your-oauth-portal.com
EXPO_PUBLIC_OAUTH_SERVER_URL=https://your-oauth-server.com
EXPO_PUBLIC_APP_ID=your_app_id
EXPO_PUBLIC_OWNER_OPEN_ID=your_owner_id
EXPO_PUBLIC_OWNER_NAME=Your Name
EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
# NODE_ENV=production

# Risk Management Settings
MAX_LOSS_PER_TRADE=1.0
MAX_POSITION_SIZE=5.0
MAX_DRAWDOWN=10.0
STOP_LOSS_PERCENT=1.0

# Trading Settings
TRADING_HOURS_ONLY=true
HALT_ON_HIGH_IMPACT_NEWS=true
VOLATILITY_HALT_THRESHOLD=30

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Tauri (Desktop App)
TAURI_PRIVATE_KEY=your_tauri_private_key
TAURI_KEY_PASSWORD=your_tauri_key_password
